{
  "name": "@cannopy/web",
  "version": "0.1.0",
  "private": true,
  "description": "Cannopy GO web app: offline-first PWA for phone, tablet and browser",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cannopy/core": "workspace:*",
    "@fontsource/padauk": "5.3.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "i18next": "26.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-router": "7.18.4",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
