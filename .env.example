# Copy to .env for local development. Never commit .env.
# All values below are development-only defaults.

# Postgres (used by the db container and by the api)
POSTGRES_DB=cannopy
POSTGRES_USER=cannopy
POSTGRES_PASSWORD=cannopy-dev-only
# For pnpm dev on your machine (the compose stack builds its own URL with host db)
DATABASE_URL=postgres://cannopy:cannopy-dev-only@localhost:5432/cannopy

# API
API_PORT=3000
LOG_LEVEL=info
# Allowed browser origins, comma separated (the web dev server by default)
CORS_ORIGINS=http://localhost:5173
# Secret used to sign session tokens. Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-dev-only

# Web (Vite reads VITE_* at build time)
VITE_API_BASE_URL=/api
